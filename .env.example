# Pecunator Environment Variables
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env

# VMO (Visual Market Observer) Configuration
VMO_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
CHART_IMG_API_KEY=your_chart_img_api_key_here

# Gemini Configuration
VMO_LLM_PROVIDER=gemini
VMO_LLM_MODEL=gemini-2.5-flash

# Image Fine-Tuning
VMO_IMAGE_WIDTH=800
VMO_IMAGE_HEIGHT=600
VMO_IMAGE_THEME=dark
VMO_CAPTURE_DELAY=5.0

# Binance Credentials (master key — shared by all bots)
PECUNATOR_BINANCE_API_KEY=your_binance_api_key_here
PECUNATOR_BINANCE_API_SECRET=your_binance_api_secret_here

# ── Sub-Account API Keys ──
DOROTHY_API_KEY=your_dorothy_api_key_here
DOROTHY_API_SECRET=your_dorothy_api_secret_here
ELPHABA_API_KEY=your_elphaba_api_key_here
ELPHABA_API_SECRET=your_elphaba_api_secret_here
