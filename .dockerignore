# .dockerignore — keep build context lean and reproducible.
# Anything matched here is *not* sent to the Docker daemon.

# Virtualenvs (venv must be rebuilt inside the image, never copied from host)
.venv
venv
ENV
env

# Git metadata
.git
.gitignore
.gitattributes
.github

# Editor / IDE
.vscode
.idea
*.swp
*.swo
*~

# Python build / cache
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
build
dist
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.tox
.cache

# Frontend / desktop UI — not needed for backend image
flutter_app
node_modules

# Examples and notebooks (kept out of the runtime image to reduce size)
examples

# Internal handoff notes (kept out of runtime; READMEs are kept)
PHASE2_HANDOFF.md
PHASE3_HANDOFF.md
WORKPLAN.md
CHANGELOG.md
.github/CI_DOCKER_SMOKE_PROPOSAL.md

# Local secrets / state (NEVER ship)
.env
.env.*
!.env.example
*.key
*.pem
backtester/.vault
backtester/data
backtester/results
*.duckdb

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Scratch / one-off files
scratch_test.py
scratch_pecunator
*.scratch.py
temp_repos
apply_sdk_patch.bat

# Docker meta itself (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore

# Pre-commit config (host-side tooling only)
.pre-commit-config.yaml
